<header class="header" role="banner">
  <div class="header__inner container">
    <a href="{{siteUrl}}" class="header__wordmark" aria-label="{{@config.custom.siteTitle}} — Home">
      {{@config.custom.siteTitle}}
    </a>

    <nav class="header__nav" role="navigation" aria-label="Main navigation">
      <ul class="header__menu">
        {{#each menu}}
          <li class="header__menu-item{{#if isCurrent}} header__menu-item--active{{/if}}">
            <a href="{{url}}" class="header__link"{{#if isExternalUrl}} target="_blank" rel="noopener noreferrer"{{/if}}>
              {{label}}
            </a>
          </li>
        {{/each}}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="header__toggle header__toggle--theme" type="button" aria-label="Toggle dark mode" id="theme-toggle">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button class="header__toggle header__toggle--menu" type="button" aria-label="Menu" aria-expanded="false" id="menu-toggle">
        <span class="header__hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  {{!-- Mobile menu overlay --}}
  <div class="nav-overlay" id="nav-overlay" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <nav class="nav-overlay__inner" role="navigation">
      <ul class="nav-overlay__menu">
        {{#each menu}}
          <li class="nav-overlay__item">
            <a href="{{url}}" class="nav-overlay__link"{{#if isExternalUrl}} target="_blank" rel="noopener noreferrer"{{/if}}>
              {{label}}
            </a>
          </li>
        {{/each}}
      </ul>
    </nav>
  </div>
</header>
