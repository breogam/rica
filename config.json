{
  "name": "rica-bouso",
  "version": "1.0.0",
  "author": "Rica Bouso",
  "license": "MIT",
  "renderer": {
    "relatedPostsNumber": 3,
    "tagsPostsNumber": 10,
    "authorPostsNumber": 10,
    "searchPostsNumber": 20,
    "postsPerPage": 10,
    "tagPostsPerPage": 10
  },
  "supportedFeatures": {
    "menuPosition": ["main", "footer"],
    "tagDescription": true,
    "postImage": true,
    "authorBio": true,
    "authorImage": true
  },
  "pageTemplates": {
    "about": "About Page",
    "portfolio": "Portfolio Page",
    "contact": "Contact Page"
  },
  "menus": {
    "main": {
      "name": "Main Navigation",
      "position": "header",
      "items": {
        "menuItem": {
          "label": "Menu Item",
          "link": "#"
        }
      }
    },
    "footer": {
      "name": "Footer Navigation",
      "position": "footer",
      "items": {
        "menuItem": {
          "label": "Menu Item",
          "link": "#"
        }
      }
    }
  },
  "files": [
    "helpers.js",
    "dynamic-assets-mapping.js"
  ],
