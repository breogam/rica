{{> head}}
{{> header}}

<main id="main" role="main">
  <article class="contact-page">

    <header class="contact-header section" data-reveal>
      <div class="container content-narrow">
        <h1 class="contact-header__title">Say hello.</h1>
        <p class="contact-header__body">I&rsquo;m always open to interesting conversations, collaborations, and new projects. Drop me a note and I&rsquo;ll get back to you soon.</p>
      </div>
    </header>

    {{!-- Contact form --}}
    <section class="contact-form-section section">
      <div class="container content-narrow">
        {{#if @config.custom.formspreeId}}
          <form
            class="contact-form"
            action="https://formspree.io/f/{{@config.custom.formspreeId}}"
            method="POST"
            data-reveal
          >
            <div class="contact-form__field">
              <label for="contact-name" class="contact-form__label">Name</label>
              <input
                class="contact-form__input"
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="name"
              >
            </div>

            <div class="contact-form__field">
              <label for="contact-email" class="contact-form__label">Email</label>
              <input
                class="contact-form__input"
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
              >
            </div>

            <div class="contact-form__field">
              <label for="contact-subject" class="contact-form__label">Subject</label>
              <select class="contact-form__input contact-form__select" id="contact-subject" name="subject" required>
                <option value="" disabled selected>Choose a topic&hellip;</option>
                <option value="Consulting">Consulting</option>
                <option value="Speaking">Speaking</option>
                <option value="Collaboration">Collaboration</option>
                <option value="Just saying hi">Just saying hi</option>
              </select>
            </div>

            <div class="contact-form__field">
              <label for="contact-message" class="contact-form__label">Message</label>
              <textarea
                class="contact-form__input contact-form__textarea"
                id="contact-message"
                name="message"
                rows="6"
                required
              ></textarea>
            </div>

            <button class="contact-form__submit btn btn--primary" type="submit">
              Send message
            </button>
          </form>
        {{else}}
          <div class="writing__empty" data-reveal>
            <p>Contact form is being set up. In the meantime, feel free to reach out directly.</p>
          </div>
        {{/if}}

        {{!-- Direct contact info --}}
        <div class="contact-direct" data-reveal>
          {{#if @config.custom.contactEmail}}
            <p class="contact-direct__item">
              <span class="contact-direct__label">Email</span>
              <a href="mailto:{{@config.custom.contactEmail}}">{{@config.custom.contactEmail}}</a>
            </p>
          {{/if}}
          {{#if @config.custom.linkedinUrl}}
            <p class="contact-direct__item">
              <span class="contact-direct__label">LinkedIn</span>
              <a href="{{@config.custom.linkedinUrl}}" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
            </p>
          {{/if}}
          <p class="contact-direct__item">
            <span class="contact-direct__label">Location</span>
            Chicago, IL
          </p>
        </div>
      </div>
    </section>

  </article>
</main>

{{> footer}}
